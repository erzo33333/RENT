@startuml C4_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Контекстная диаграмма ИС арендного жилья (C4 Level 1)

Person(landlord, "Арендодатель", "Управляет объектами, договорами, платежами, имуществом. Администратор системы.")
Person(tenant, "Арендатор", "Проживающий. Вносит показания, оплаты, заявки, просматривает договор и расчёты.")

System(rentSys, "ИС учёта и мониторинга арендного жилья", "Веб-приложение для централизованного учёта объектов, договоров, платежей, имущества, показаний счётчиков и аналитики.")

System_Ext(email, "Email-сервис (SMTP)", "Отправка email-уведомлений о платежах, сроках, показаниях.")

Rel(landlord, rentSys, "Управляет объектами, договорами, платежами, отчётами", "HTTPS")
Rel(tenant, rentSys, "Вносит показания, оплаты, заявки; просматривает данные", "HTTPS")

Rel(rentSys, email, "Отправляет email-уведомления", "SMTP")

@enduml